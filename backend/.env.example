# Server
PORT=5000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/apiquest

# Auth
JWT_ACCESS_SECRET=replace_with_long_random_string_min_32_chars
JWT_REFRESH_SECRET=replace_with_another_long_random_string_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Sandbox — pre-configured public endpoints
SANDBOX_REST_BASE_URL=https://jsonplaceholder.typicode.com
SANDBOX_GRAPHQL_BASE_URL=https://countries.trevorblades.com/graphql
SANDBOX_SOAP_BASE_URL=http://www.dneonline.com/calculator.asmx

# Rate limiting (sandbox routes)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30
